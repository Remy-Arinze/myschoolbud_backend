{
  "name": "agora-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npx prisma generate && node --max-old-space-size=4096 ./node_modules/@nestjs/cli/bin/nest.js build",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:check": "node -e \"try { require('child_process').execSync('npm audit --omit=dev --audit-level=high', { stdio: 'inherit' }); } catch { console.warn('[check] npm audit reported high+ issues (not blocking). Run npm audit for details.'); }\"",
    "check:commit": "npm run lint:check && npm run typecheck && npm run audit:check",
    "check:push": "npm test && npm run build",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name migration --skip-generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-agora-subjects": "tsx prisma/seed-agora-subjects.ts",
    "db:check-failed-migration": "tsx scripts/check-failed-migration.ts",
    "db:resolve-failed-migration": "tsx scripts/check-failed-migration.ts --resolve",
    "db:apply-missing-class-arms": "prisma db execute --file scripts/apply-missing-class-arms.sql",
    "backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "push": "git push origin dev && git checkout staging && git merge dev --no-edit && git push origin staging && git checkout master && git merge staging --no-edit && git push origin master && git checkout dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/lib-storage": "^3.1062.0",
    "@bull-board/api": "^6.20.6",
    "@bull-board/express": "^6.20.6",
    "@bull-board/nestjs": "^6.20.6",
    "@langchain/core": "^1.2.10",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.12",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "^10.56.0",
    "@types/nodemailer": "^7.0.4",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.6",
    "decimal.js": "^10.6.0",
    "dropbox": "^10.44.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "googleapis": "^166.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "megajs": "^1.3.10",
    "multer": "^2.3.0",
    "nanoid": "^3.3.18",
    "nodemailer": "^9.1.0",
    "openai": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "react-international-phone": "^4.8.0",
    "readable-stream": "^4.7.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "tsx": "^4.7.0",
    "uuid": "^14.0.0",
    "validator": "^13.15.26",
    "web-push": "^3.6.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "csv-parse": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "esbuild": "^0.28.2",
    "@babel/core": "^7.29.7",
    "qs": "^6.15.2",
    "brace-expansion": "^5.0.9",
    "tmp": "^0.2.6",
    "uuid": "^14.0.0",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "body-parser": "^2.3.0",
    "@opentelemetry/core": "^2.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": "50%",
    "forceExit": true,
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/common/test/uuid-stub.js"
    }
  }
}
