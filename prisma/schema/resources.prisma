model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  teacherId    String
  date         DateTime @db.Date
  status       String
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
}

model Fee {
  id           String    @id @default(cuid())
  enrollmentId String
  schoolId     String
  description  String
  amount       Decimal
  dueDate      DateTime
  paidDate     DateTime?
  status       String    @default("PENDING")
  feeScheduleId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule? @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([schoolId])
  @@index([status])
  @@index([dueDate])
  @@index([feeScheduleId])
}

model ClassResource {
  id          String   @id @default(cuid())
  name        String // Original filename
  fileName    String // Stored filename
  filePath    String // Path to file in storage
  fileSize    Int // File size in bytes
  mimeType    String // e.g., "application/pdf", "image/jpeg"
  fileType    String // "PDF", "DOCX", "IMAGE", etc.
  description String?
  classId     String? // For TERTIARY or schools without ClassArms
  classArmId  String? // For PRIMARY/SECONDARY schools using ClassArms (optional - can be shared per ClassLevel)
  uploadedBy  String // User ID who uploaded
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class    Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classArm ClassArm? @relation("ClassArmResources", fields: [classArmId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([classArmId])
  @@index([uploadedBy])
  @@index([fileType])
}

model StudentResource {
  id          String   @id @default(cuid())
  name        String // Original filename
  fileName    String // Stored filename
  filePath    String // Path to file in storage
  fileSize    Int // File size in bytes
  mimeType    String // e.g., "application/pdf", "image/jpeg"
  fileType    String // "PDF", "DOCX", "IMAGE", etc.
  description String?
  studentId   String
  uploadedBy  String // User ID who uploaded (should match student's userId)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([uploadedBy])
  @@index([fileType])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  action      String // e.g., "generate_quiz", "grade_essay"
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  schoolId  String?
  contextId String? // Optional: link to a specific class or context
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  pendingPlans LoisPendingPlan[]
  loisMemory Json?

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user", "assistant", "system"
  content        String   @db.Text
  toolEvents     Json? // Optional: stores structured tool execution history
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum LoisPendingPlanKind {
  TIMETABLE
  SCHEME
}

enum LoisPendingPlanStatus {
  PROPOSED
  APPLIED
  CANCELLED
  EXPIRED
}

/// Server-issued confirmation for Lois curator writes. Apply requires this id.
model LoisPendingPlan {
  id             String                @id @default(cuid())
  conversationId String?
  userId         String
  schoolId       String
  kind           LoisPendingPlanKind
  payload        Json
  summary        String                @db.Text
  expiresAt      DateTime
  status         LoisPendingPlanStatus @default(PROPOSED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, schoolId, status])
  @@index([conversationId])
  @@index([expiresAt])
}

model KnowledgeChunk {
  id        String                       @id @default(cuid())
  schoolId  String
  content   String                       @db.Text
  metadata  Json // Stores entity type, ID, and permission rules
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// DB-managed Lois skills.
/// Each skill is a named block of instructions injected into the system prompt
/// at runtime for users matching the targetRoles.
/// Super admins craft and publish these — zero code deployment needed.
model LoisSkill {
  id           String   @id @default(cuid())
  name         String
  description  String   // Internal description visible in the dashboard
  content      String   @db.Text // The actual instructions injected into the prompt
  /// Comma-separated roles: TEACHER | SCHOOL_ADMIN | STUDENT | ALL
  targetRoles  String   @default("ALL")
  category     String   @default("behavior") // behavior | knowledge | tone | workflow
  isActive     Boolean  @default(true)
  priority     Int      @default(100) // lower = injected first
  /// Internal notes for super admins — never injected into Lois's prompt
  internalNotes String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([priority])
}

/// Global system-level Lois configuration managed by super admins.
/// Stores custom overrides for the core system prompt sections.
/// There is at most one row (singleton, keyed by id = 'global').
model SystemPromptConfig {
  id String @id @default("global")

  /// Override for the core identity/intro block (replaces the default Lois identity paragraph)
  identityOverride     String?  @db.Text
  /// Additional rules to append after core operational rules
  additionalRules      String?  @db.Text
  /// Override for the TEACHER role-specific rules block
  teacherRulesOverride String?  @db.Text
  /// Override for the SCHOOL_ADMIN role-specific rules block
  adminRulesOverride   String?  @db.Text
  /// Override for the STUDENT role-specific rules block
  studentRulesOverride String?  @db.Text
  /// Free-form notes visible only to super admins (not injected into prompt)
  internalNotes        String?  @db.Text

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Background findings from Lois skill loops (academic risk, drops, SoW gaps, attendance, fees, admissions).
model LoisInsight {
  id          String   @id @default(cuid())
  schoolId    String
  type        String
  severity    String   @default("warning")
  title       String
  summary     String   @db.Text
  evidence    Json
  studentIds  String[] @default([])
  classIds    String[] @default([])
  teacherIds  String[] @default([])
  href        String?
  askPrompt   String?  @db.Text
  fingerprint String
  seenAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reads  LoisInsightRead[]

  @@unique([schoolId, fingerprint])
  @@index([schoolId, createdAt])
  @@index([schoolId, type])
}

/// Per-admin read receipt so the Ask Lois badge is unread-only.
model LoisInsightRead {
  id        String   @id @default(cuid())
  insightId String
  userId    String
  readAt    DateTime @default(now())

  insight LoisInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insightId, userId])
  @@index([userId, readAt])
}

/// Per-school Lois configuration.
/// Allows school admins to customise Lois personality/tone without a code change.
model LoisConfig {
  id               String   @id @default(cuid())
  schoolId         String   @unique
  /// Optional custom greeting shown at conversation start
  customGreeting   String?
  /// Tone guidance injected into the system prompt (e.g. "Always reply formally")
  toneNote         String?
  /// Topics Lois should refuse to discuss for this school
  restrictedTopics String?
  /// Additional school-specific context (e.g. "We are a faith-based school")
  schoolContext    String?  @db.Text
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}
